# Local development only. Copy values into your deployment environment separately.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-before-deploy
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty for the local SQLite database.
# In production, use the private PostgreSQL connection URL from the hosting provider.
DATABASE_URL=

# Optional backup location. Keep production backups outside the web application folder.
TEMPLE_BACKUP_DIR=
